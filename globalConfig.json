{
    "pages": {
        "configuration": {
            "title": "Configuration",
            "description": "Meraki Dashboard API accounts",
            "tabs": [
                {
                    "name": "account",
                    "title": "Accounts",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "API base URL",
                                "field": "base_url"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "field": "name",
                            "help": "A unique name for the account.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Account Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of account name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "API base URL",
                            "field": "base_url",
                            "defaultValue": "https://api.meraki.com/api/v1",
                            "help": "Use the regional host if needed, e.g. https://api.meraki.cn/api/v1.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Must be an https URL.",
                                    "pattern": "^https://\\S+$"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "API key",
                            "field": "api_key",
                            "help": "Meraki Dashboard API key. Read-only access is enough.",
                            "required": true,
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of API key should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "loggingTab"
                }
            ]
        },
        "inputs": {
            "title": "Inputs",
            "description": "Poll organization site-to-site VPN firewall rules",
            "services": [
                {
                    "name": "meraki_vpnfw_rules",
                    "title": "Meraki VPN firewall rules",
                    "inputHelperModule": "meraki_vpnfw_rules_helper",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ]
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "field": "interval",
                            "defaultValue": "300",
                            "options": {
                                "range": [
                                    60,
                                    86400
                                ]
                            },
                            "help": "Polling interval in seconds.",
                            "required": true
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "label": "Index"
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account to use",
                            "field": "account",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "Account to use for this input.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Organization IDs",
                            "field": "organization_ids",
                            "help": "Comma-separated Meraki organization IDs, e.g. 123456,234567.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Comma-separated numeric organization IDs.",
                                    "pattern": "^\\s*\\d+(\\s*,\\s*\\d+)*\\s*$"
                                }
                            ]
                        }
                    ]
                }
            ],
            "table": {
                "actions": [
                    "edit",
                    "delete",
                    "clone"
                ],
                "header": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Organizations",
                        "field": "organization_ids"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled"
                    }
                ],
                "moreInfo": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Account",
                        "field": "account"
                    },
                    {
                        "label": "Organizations",
                        "field": "organization_ids"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled",
                        "mapping": {
                            "true": "Inactive",
                            "false": "Active"
                        }
                    }
                ]
            }
        }
    },
    "meta": {
        "name": "TA-meraki-vpnfw",
        "restRoot": "ta_meraki_vpnfw",
        "version": "1.0.1",
        "displayName": "Meraki VPN Firewall Rule Hits",
        "schemaVersion": "0.0.10",
        "supportedThemes": [
            "light",
            "dark"
        ]
    }
}
